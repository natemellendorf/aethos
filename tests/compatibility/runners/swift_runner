#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PRIMARY_MAIN="$SCRIPT_DIR/swift_impl/main.swift"

REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_ROOT" ]]; then
  FALLBACK_ROOT="$(cd -- "$SCRIPT_DIR/../../.." && pwd)"
  if [[ -f "$FALLBACK_ROOT/Package.swift" ]]; then
    REPO_ROOT="$FALLBACK_ROOT"
  fi
fi

if [[ -n "$REPO_ROOT" && -f "$REPO_ROOT/Package.swift" ]]; then
  exec swift run --package-path "$REPO_ROOT" aethos-swift-runner -- "$@"
fi

if [[ -f "$PRIMARY_MAIN" ]]; then
  exec swift "$PRIMARY_MAIN" "$@"
fi

FALLBACK_MAIN="$PWD/runners/swift_impl/main.swift"
if [[ -f "$FALLBACK_MAIN" ]]; then
  exec swift "$FALLBACK_MAIN" "$@"
fi

echo "swift_runner could not locate main.swift" >&2
exit 2
