{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethos.dev/fixtures/orchestration/mixed-bearer/v1/schema.json",
  "title": "Aethos Mixed-Bearer Fixture Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureID",
    "nowUnixMs",
    "timeScope",
    "encounter",
    "forwarding",
    "admin_record",
    "expected"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mbe-mixed-bearer.v1"
    },
    "fixtureID": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "nowUnixMs": {
      "$ref": "#/$defs/uint64"
    },
    "timeScope": {
      "$ref": "#/$defs/timeScope"
    },
    "encounter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/encounterTelemetryEvent"
      }
    },
    "forwarding": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forwardingTelemetryEvent"
      }
    },
    "admin_record": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adminRecordTelemetryEvent"
      }
    },
    "declaredExtensionRefusalReasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extensionRefusalReasonDeclaration"
      },
      "uniqueItems": true
    },
    "extensionRefusalReasonsDeclaredInManifest": {
      "type": "boolean",
      "default": false,
      "description": "Set true when this fixture uses extension refusal codes declared in suite manifest.json."
    },
    "expected": {
      "$ref": "#/$defs/expectedOutcome"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expected": {
            "type": "object",
            "properties": {
              "refusalReason": {
                "type": "string",
                "pattern": "^x_[a-z0-9_]+$"
              }
            },
            "required": [
              "refusalReason"
            ]
          }
        },
        "required": [
          "expected"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "declaredExtensionRefusalReasons"
            ],
            "properties": {
              "declaredExtensionRefusalReasons": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "extensionRefusalReasonsDeclaredInManifest"
            ],
            "properties": {
              "extensionRefusalReasonsDeclaredInManifest": {
                "const": true
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "timeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAtUnixMs",
        "staleAfterUnixMs"
      ],
      "properties": {
        "observedAtUnixMs": {
          "$ref": "#/$defs/uint64"
        },
        "staleAfterUnixMs": {
          "$ref": "#/$defs/uint64"
        },
        "validUntilUnixMs": {
          "$ref": "#/$defs/uint64"
        }
      },
      "description": "Invariants such as observedAtUnixMs <= staleAfterUnixMs and staleAfterUnixMs <= validUntilUnixMs (when present) are runner-enforced."
    },
    "telemetryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "eventID",
        "layer",
        "eventType",
        "eventSequence",
        "occurredAtUnixMs",
        "encounterContextID",
        "encounterInstanceID",
        "encounterAttemptID",
        "payload"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "eventID": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "enum": [
            "encounter",
            "forwarding",
            "admin_record"
          ]
        },
        "eventType": {
          "type": "string",
          "minLength": 1
        },
        "eventSequence": {
          "$ref": "#/$defs/uint64"
        },
        "occurredAtUnixMs": {
          "$ref": "#/$defs/uint64"
        },
        "encounterContextID": {
          "type": "string",
          "minLength": 1
        },
        "encounterInstanceID": {
          "type": "string",
          "minLength": 1
        },
        "encounterAttemptID": {
          "type": "string",
          "minLength": 1
        },
        "bearerID": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "encounterTelemetryEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/telemetryEvent"
        },
        {
          "properties": {
            "layer": {
              "const": "encounter"
            }
          }
        }
      ]
    },
    "forwardingTelemetryEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/telemetryEvent"
        },
        {
          "properties": {
            "layer": {
              "const": "forwarding"
            }
          }
        }
      ]
    },
    "adminRecordTelemetryEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/telemetryEvent"
        },
        {
          "properties": {
            "layer": {
              "const": "admin_record"
            }
          }
        }
      ]
    },
    "canonicalRefusalReason": {
      "enum": [
        "security_posture_insufficient",
        "downgrade_resistance_triggered",
        "resource_limit_exceeded",
        "budget_exhausted",
        "time_scope_stale",
        "time_scope_expired",
        "time_scope_invalid",
        "capability_mismatch",
        "peer_incompatible",
        "session_unavailable",
        "resume_not_supported",
        "resume_token_invalid",
        "resume_state_missing"
      ]
    },
    "refusalReason": {
      "anyOf": [
        {
          "$ref": "#/$defs/canonicalRefusalReason"
        },
        {
          "type": "string",
          "pattern": "^x_[a-z0-9_]+$"
        }
      ]
    },
    "extensionRefusalReasonDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "layer",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^x_[a-z0-9_]+$"
        },
        "layer": {
          "enum": [
            "encounter",
            "forwarding",
            "admin_record"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "accept",
            "reject",
            "stop",
            "defer"
          ]
        },
        "refusalReason": {
          "$ref": "#/$defs/refusalReason"
        },
        "terminalOutcome": {
          "enum": [
            "clean-end",
            "failed-end",
            "policy-stop"
          ]
        },
        "stopClass": {
          "enum": [
            "policy_stop",
            "completed",
            "no_eligible_items",
            "budget_exhausted"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accept"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "refusalReason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "reject",
                  "stop",
                  "defer"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "refusalReason"
            ]
          }
        }
      ]
    }
  }
}
